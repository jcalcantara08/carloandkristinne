# =========================================
# Carlo and Kristinne wedding site
# Copy to .env.local for development.
# Set the same keys in Vercel for production.
# Never commit .env.local.
#
# OneDrive warning: this project lives inside OneDrive, so a gitignored
# .env.local still syncs to Microsoft's cloud. Gitignore protects the repo,
# not the disk. Treat every secret here as visible to that account, and
# rotate anything sensitive.
# =========================================

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://carloandkristinne.com

# --- Admin ---
# Required. The app refuses to run an auth path without these. No fallbacks,
# no default password. A build that will not start beats an open door.
ADMIN_PASSWORD=
# Generate: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# --- Supabase ---
# RSVPs, the guestbook and the photo album all need these.
# Without them the public site still renders; nothing can be saved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS entirely. Never expose to the browser.
# If it ever reaches a client bundle, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend), optional ---
# Without a key, mail is logged and skipped. RSVPs are still saved, because
# the row is always persisted before anything is sent.
RESEND_API_KEY=
# Send from a subdomain you control, never from a Gmail address: DMARC fails it.
FROM_EMAIL=noreply@carloandkristinne.com
# Where new RSVP notifications land.
CONTACT_TO_EMAIL=

# --- Rate limiting (Upstash), optional ---
# Falls back to an in-memory bucket, which is per instance and therefore weak.
# Fine for a hundred invited guests; set these if the site is ever public.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
